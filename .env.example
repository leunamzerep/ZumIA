# Copia a .env.local (ignorado por git) para desarrollo. No pongas secretos aquí:
# las variables VITE_ quedan dentro del JavaScript público.

# Worker de verificación de clientes (worker/). En local: `npm run dev` dentro de worker/.
# En producción se define en el build de GitHub Pages (paso 6 del plan de verificación).
VITE_VERIFY_API_URL=http://localhost:8787

# Pago del anticipo con Wompi (usa el mismo Worker de VITE_VERIFY_API_URL).
# SOLO el texto exacto "true" lo enciende. Cualquier otro valor, o no definirla, lo apaga y la sección de pago
# no existe (ni se renderiza ni se prerenderiza). Déjala comentada si no estás probando pagos.
# VITE_PAYMENTS_ENABLED=true
